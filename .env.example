# Lodge on the Lake — environment variables
#
# Copy to `.env.local` for local development. NEVER commit real values.
# In staging/production, set these in the hosting platform's secret manager.
# Variables without the NEXT_PUBLIC_ prefix are server-only. Never put a
# secret in a NEXT_PUBLIC_* variable: those are bundled into browser code.

# --- Site -------------------------------------------------------------------
# Canonical base URL (no trailing slash). Used for metadata, sitemap and links.
SITE_URL=http://localhost:3000
# Search engines are told not to index the site unless this is exactly "true".
# Leave false until the owner has approved launch.
SITE_INDEXABLE=false
# IANA time zone that defines the property's calendar dates.
PROPERTY_TIME_ZONE=Europe/London

# --- Database (managed PostgreSQL, e.g. Supabase) ----------------------------
# Pooled connection string used by the application at runtime.
DATABASE_URL=
# Direct (non-pooled) connection string used only for running migrations.
DATABASE_URL_UNPOOLED=
# Integration tests only: a disposable database. Tests will truncate tables.
TEST_DATABASE_URL=

# --- Admin authentication (Phase 2; Supabase Auth proposed) ------------------
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# Comma-separated allowlist of owner/admin email addresses.
ADMIN_EMAILS=

# --- Stripe (Phase 3; test mode keys only until launch is approved) ----------
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=
# sk_live_ keys are refused unless this is exactly "true". Set only after the
# owner has explicitly approved live payments.
STRIPE_LIVE_MODE_APPROVED=false

# --- Google Calendar OAuth (Phase 4) ----------------------------------------
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=
GOOGLE_OAUTH_REDIRECT_URI=http://localhost:3000/api/integrations/google/callback

# --- Credential encryption ---------------------------------------------------
# 32-byte key, base64 encoded, used to encrypt OAuth refresh tokens and private
# iCal feed URLs at rest. Generate with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
# Rotate by adding a new key version; see docs/SECURITY.md.
CREDENTIALS_ENCRYPTION_KEY=
CREDENTIALS_ENCRYPTION_KEY_VERSION=1

# --- Transactional email (Phase 3; provider TBC, e.g. Resend or Postmark) ----
EMAIL_PROVIDER_API_KEY=
EMAIL_FROM_ADDRESS=
OWNER_NOTIFICATION_EMAIL=

# --- Background jobs ---------------------------------------------------------
# Shared secret the scheduler must present when calling job endpoints.
CRON_SECRET=

# --- Monitoring --------------------------------------------------------------
SENTRY_DSN=
