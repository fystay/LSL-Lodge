# Lodge on the Lake — environment variables
#
# Copy to `.env.local` for local development. NEVER commit real values.
# In staging/production, set these in the hosting platform's secret manager.
# Variables without the NEXT_PUBLIC_ prefix are server-only. Never put a
# secret in a NEXT_PUBLIC_* variable: those are bundled into browser code.

# --- Site -------------------------------------------------------------------
# Canonical base URL (no trailing slash). Used for metadata, sitemap and links.
SITE_URL=http://localhost:3000
# Search engines are told not to index the site unless this is exactly "true".
# Leave false until the owner has approved launch.
SITE_INDEXABLE=false
# IANA time zone that defines the property's calendar dates.
PROPERTY_TIME_ZONE=Europe/London

# --- Database (managed PostgreSQL, e.g. Supabase) ----------------------------
# Pooled connection string used by the application at runtime.
DATABASE_URL=
# Direct (non-pooled) connection string used only for running migrations.
DATABASE_URL_UNPOOLED=
# Integration tests only: a disposable database. Tests will truncate tables.
TEST_DATABASE_URL=

# --- Booking flow -----------------------------------------------------------
# Slug of the property row the site books (created by the seed or admin setup).
PROPERTY_SLUG=lodge-on-the-lake
# Shows the online booking flow (search → request → owner approval → payment).
# Ignored on Vercel production until launch is approved. The property must
# also have bookings switched on in /admin/settings.
BOOKING_PREVIEW=false
# Instant booking (pay immediately, no owner approval) is refused unless this
# is exactly "true". Leave false: the owner has chosen host approval, and
# instant booking needs its own approved policy first.
INSTANT_BOOKING_APPROVED=false
# Signs the guest links in booking emails (view booking / pay now): at least
# 32 random characters. Without it, emails can't include a booking link.
GUEST_LINK_SECRET=

# --- Admin authentication -----------------------------------------------------
# "local" = email allowlist + password, for local development/tests ONLY
# (refused on any Vercel deployment). "supabase" = managed auth with MFA
# (planned). Anything else disables the admin area.
ADMIN_AUTH_MODE=
# Comma-separated allowlist of owner/admin email addresses.
ADMIN_EMAILS=
# Local mode only: at least 16 characters.
ADMIN_LOCAL_PASSWORD=
# Signs admin session cookies: at least 32 random characters.
ADMIN_SESSION_SECRET=
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# --- Stripe (test mode keys only until launch is approved) -------------------
# Server-only. Must start sk_test_ unless live mode has been approved.
STRIPE_SECRET_KEY=
# Signing secret of the webhook endpoint (/api/webhooks/stripe), or the one
# printed by `stripe listen` for local testing. Starts whsec_.
STRIPE_WEBHOOK_SECRET=
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=
# sk_live_ keys are refused unless this is exactly "true". Set only after the
# owner has explicitly approved live payments.
STRIPE_LIVE_MODE_APPROVED=false

# --- Google Calendar OAuth (Phase 4) ----------------------------------------
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=
GOOGLE_OAUTH_REDIRECT_URI=http://localhost:3000/api/integrations/google/callback

# --- Credential encryption ---------------------------------------------------
# 32-byte key, base64 encoded, used to encrypt OAuth refresh tokens and private
# iCal feed URLs at rest. Generate with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
# Rotate by adding a new key version; see docs/SECURITY.md.
CREDENTIALS_ENCRYPTION_KEY=
CREDENTIALS_ENCRYPTION_KEY_VERSION=1

# --- Transactional email (Resend) ---------------------------------------------
# "off" (default): nothing is sent; messages show as "not sent" and can be
#   previewed in /admin.
# "resend-sandbox": sent via Resend, but always to Resend's test inbox
#   (delivered@resend.dev), never to real guests.
# "resend": real recipients; also needs EMAIL_LIVE_DELIVERY_APPROVED=true.
EMAIL_DELIVERY=off
EMAIL_PROVIDER_API_KEY=
# A sender on a domain verified in Resend (SPF, DKIM, DMARC).
EMAIL_FROM_ADDRESS=
# Set to "true" only after the owner approves real guest emails.
EMAIL_LIVE_DELIVERY_APPROVED=false
# Where owner alerts (new requests, payment reviews, sync failures) go.
OWNER_NOTIFICATION_EMAIL=

# --- Background jobs ---------------------------------------------------------
# Shared secret the scheduler must present when calling job endpoints.
CRON_SECRET=

# --- Monitoring --------------------------------------------------------------
SENTRY_DSN=
